# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/farmerconnect_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# 256-bit (32+ character) HMAC-SHA secret key for JWT signing
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key

# Google Gemini API Key (server-side)
GEMINI_API_KEY=your_gemini_api_key
